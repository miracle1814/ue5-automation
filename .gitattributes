# Normalize line endings: text files LF in repo, native in working tree
* text=auto

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Unreal assets are binary
*.uasset binary
*.umap binary
*.uplugindata binary

# DLLs / PDBs are binary
*.dll binary
*.pdb binary
