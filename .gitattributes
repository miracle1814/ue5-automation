# Normalize line endings: text files LF in repo, native in working tree
* text=auto

# Python/JSON/sources: LF everywhere (fingerprint + hash stability across checkouts)
*.py text eol=lf
*.json text eol=lf
*.tmpl text eol=lf
*.md text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.cs text eol=lf

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Unreal assets are binary
*.uasset binary
*.umap binary
*.uplugindata binary

# DLLs / PDBs are binary
*.dll binary
*.pdb binary
